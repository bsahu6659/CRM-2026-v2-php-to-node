# ---------------------------------------------------------------------------
# Settings for creating the tables and demo accounts in the hosted TiDB Cloud
# database FROM YOUR OWN COMPUTER (Render's free plan has no shell).
#
#   cp .env.tidb.example .env.tidb      # fill in the four DB_ values below
#   ENV_FILE=.env.tidb npm run migrate
#   ENV_FILE=.env.tidb npm run seed -- --demo
#
# .env.tidb is git-ignored. Take the values from TiDB Cloud:
# your cluster > Connect > "Connect With: General".
# ---------------------------------------------------------------------------

# development: the seed then gives every account it creates SEED_PASSWORD.
APP_ENV=development

DB_HOST=gateway01.xxxxx.prod.aws.tidbcloud.com
DB_PORT=4000
DB_NAME=growvanta
DB_USER=xxxxxxxx.root
DB_PASS=
DB_SSL=1

# Password for the demo logins (superadmin@growvanta.com and
# admin@demorealty.test). The site is public, so do not keep Growvanta@123.
SEED_PASSWORD=

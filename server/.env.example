# ---------------------------------------------------------------------------
# Growvanta CRM - API server configuration
#
# Copy this file to `.env` and fill it in. Never commit the real `.env`, and
# never rename this example over a working one: doing so replaces live
# settings with placeholders and takes the site down.
# ---------------------------------------------------------------------------

APP_ENV=production
APP_DEBUG=0
# Public URL of the API itself. Used in emails, Meta OAuth redirects and
# webhook callback URLs, so it must be the address the outside world reaches.
APP_URL=https://api.yourdomain.com
PORT=4000

# Comma-separated list of browser origins allowed to call this API with
# cookies. Must include the exact scheme, host and port the React app is
# served from. Without this, every browser request fails CORS.
CORS_ORIGINS=https://crm.yourdomain.com

# Where the React app is served from. Password-reset, invite and verification
# links point here. Defaults to the first CORS_ORIGINS entry.
CLIENT_URL=https://crm.yourdomain.com

# ---------------------------------------------------------------------------
# Database (MySQL 8 / MariaDB 10.4+)
# ---------------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=growvanta
DB_USER=growvanta
DB_PASS=
DB_POOL_SIZE=10
# Set DB_SSL=1 for hosted databases that require TLS (TiDB Cloud does).
# DB_SSL_CA only for a provider whose certificate is not publicly trusted.
DB_SSL=0
# DB_SSL_CA=./certs/provider-ca.pem
# Session sql_mode for every connection. The default matches the MariaDB the
# PHP edition was built on (no ONLY_FULL_GROUP_BY); leave it unless you know.
# DB_SQL_MODE=STRICT_TRANS_TABLES,ERROR_FOR_DIVISION_BY_ZERO,NO_ENGINE_SUBSTITUTION

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
# 32+ random characters. Generate with:  openssl rand -base64 48
#
# APP_KEY derives session tokens AND encrypts stored integration secrets
# (Meta page access tokens). CHANGING IT MAKES EVERY STORED TOKEN UNREADABLE
# and every integration has to be reconnected. Back it up with the database.
APP_KEY=

SESSION_TTL_HOURS=12
REMEMBER_ME_TTL_DAYS=30

# Set COOKIE_SECURE=1 whenever the site is served over HTTPS (required in
# production). If the API and the React app are on different sites, set
# COOKIE_SAMESITE=None - which browsers only honour together with Secure.
COOKIE_SECURE=1
COOKIE_SAMESITE=Lax
# Only set this when API and app share a parent domain, e.g. .yourdomain.com
# COOKIE_DOMAIN=

# ---------------------------------------------------------------------------
# Rate limiting (counted in the rate_limit_hits table, shared across workers)
# ---------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MIN=15
RATE_LIMIT_MAX=1000
AUTH_RATE_LIMIT_MAX=20
PUBLIC_CAPTURE_RATE_LIMIT_MAX=60

# ---------------------------------------------------------------------------
# Uploads
# ---------------------------------------------------------------------------
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10

# ---------------------------------------------------------------------------
# Outbound mail. Sends invites, password resets and staff lead alerts for
# every tenant, so these are the platform's own credentials, not a customer's.
# Leave SMTP_HOST empty to disable outbound mail entirely (the API will record
# the attempt and report it as not configured rather than failing a request).
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_ENCRYPTION=TLS
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Growvanta CRM <no-reply@yourdomain.com>"

# ---------------------------------------------------------------------------
# Meta (Facebook/Instagram) Lead Ads.
# Leave blank to disable; the Integrations screen will report it as not
# configured. META_VERIFY_TOKEN is any string you choose - you type the same
# value into the Meta app's webhook setup.
# ---------------------------------------------------------------------------
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_GRAPH_VERSION=v19.0

# ---------------------------------------------------------------------------
# Follow-up / daily-summary sweep (the PHP edition's cron/sweep.php).
# Runs inside the API process every SWEEP_INTERVAL_MIN minutes. Set it to 0
# when you run several API processes and schedule `npm run sweep` from cron
# instead.
# ---------------------------------------------------------------------------
SWEEP_INTERVAL_MIN=15

# Password given to accounts created by `npm run seed`. Change it before
# seeding anything that will be reachable from the internet.
SEED_PASSWORD=Growvanta@123

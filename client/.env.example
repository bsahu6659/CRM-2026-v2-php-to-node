# Dev-server port for the React client.
VITE_PORT=5173

# Where the Vite dev server forwards /api, /webhooks, /uploads and the public
# capture URLs (/f/KEY, /embed/KEY.js, /public-form.js).
# Production does not use this — nginx (or any reverse proxy) serves dist/
# and forwards /api to the Node process on the same origin.
VITE_API_PROXY=http://127.0.0.1:4000
